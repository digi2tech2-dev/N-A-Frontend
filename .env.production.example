# Release builds must use the backend. The frontend rejects a production bundle
# that omits VITE_DATA_PROVIDER=real or VITE_API_BASE_URL.
VITE_DATA_PROVIDER=real
VITE_API_BASE_URL=https://your-backend.example/api

# Real referrals are enabled by default in real-provider mode. Keep this value
# explicit in release configuration so production never falls back to demo data.
VITE_REFERRAL_API_ENABLED=true
