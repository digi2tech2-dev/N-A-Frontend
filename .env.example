# Data source. Use "mock" for local in-memory demo data or "real" for the backend API.
VITE_DATA_PROVIDER=mock
VITE_REFERRAL_API_ENABLED=false

# Backend API base URL. In real mode this should include the backend /api prefix.
VITE_API_BASE_URL=http://localhost:5000/api

# Public frontend URL used by referral links and share actions.
VITE_PUBLIC_APP_URL=http://localhost:3000

# Optional canonical URL used by SEO helpers.
VITE_SITE_URL=http://localhost:3000
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Public WhatsApp support number. Use digits only or a local format understood by the app.
VITE_ADMIN_WHATSAPP_NUMBER=01063068074

# Browser-side receipt validation. All VITE_* values are shipped to the browser bundle.
# Do not place private production secrets here.

# Legacy/application labels. These are not used for feature selection.
VITE_APP_ENV=development
VITE_APP_MODE=development
VITE_PUSH_NOTIFICATIONS_ENABLED=false

# Public OAuth client identifier used only by the Android native Google
# Credential Manager flow. It must be the same Web application client ID that
# the backend uses as GOOGLE_CLIENT_ID. This is an identifier, not a secret.
VITE_GOOGLE_NATIVE_WEB_CLIENT_ID=

# Non-VITE variables are not available to browser code through import.meta.env.
# Kept only for external hosting systems that may read it independently.
APP_URL=http://localhost:3000
